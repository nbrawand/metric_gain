# Database
DATABASE_URL=postgresql://metricgain:password@localhost:5432/metricgain_dev

# Security
# This placeholder is fine locally. With ENVIRONMENT=production the app refuses
# to start unless SECRET_KEY is a real value of at least 32 characters:
#   openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Environment
# "production" turns off /docs and /redoc, sends HSTS, and enforces the
# SECRET_KEY and CORS_ORIGINS checks above.
ENVIRONMENT=development

# CORS
# Exact origins, comma separated. "*" is rejected in production: credentials
# are allowed, so a wildcard would let any site read a signed-in user's data.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Google OAuth: sign-in returns 501 without this
GOOGLE_CLIENT_ID=

# Stripe: billing endpoints return 501 without these
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Where Stripe sends the user back after checkout
FRONTEND_URL=http://localhost:5173
